{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "extra-lounge-pos",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/kafopos-pra-ims.html" },
    { "source": "/pos", "destination": "/kafopos-pra-ims.html" },
    { "source": "/dashboard", "destination": "/kafopos-pra-ims.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
